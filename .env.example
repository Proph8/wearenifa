# Public address of the site, used for link previews, canonical URLs and the sitemap.
SITE_URL=https://wearnifa.com

# Family passphrase that gates /keystatic before GitHub sign-in. Required in production.
FAMILY_PASSPHRASE=change-me

# GitHub sign-in for the editor (Keystatic creates these the first time you open /keystatic
# with NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=pending in development).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
